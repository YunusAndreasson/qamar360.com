{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "babel.config.js",
    "plugins/**/*.js",
    "scripts/**/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/lib/database.types.ts",
    "web/**"
  ],
  "ignoreBinaries": ["python3"],
  "ignoreDependencies": [
    "@jest/globals",
    "@babel/types",
    "@typescript-eslint/parser"
  ]
}
