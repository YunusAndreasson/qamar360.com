{
  "mcpServers": {
    "argent": {
      "type": "stdio",
      "command": "argent",
      "args": [
        "mcp"
      ]
    },
    "shadcn": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "cd \"$(git rev-parse --show-toplevel)/web\" && exec npx -y shadcn@latest mcp"
      ]
    }
  }
}
