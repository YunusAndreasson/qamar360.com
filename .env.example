# Supabase — the publishable key (sb_publishable_*) is safe to ship in the client.
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Google sign-in (optional). Without the web client id the Google button is
# hidden; the iOS one is needed only on iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
