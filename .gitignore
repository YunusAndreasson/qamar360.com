# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Argent (device screen recordings, etc.)
.argent/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Store-submission credentials (never commit).
/credentials/

# env / secrets — never commit (.env.example is kept)
.env
.env.*
!.env.example

# The root npm lockfile IS committed, so EAS's `npm ci` reproduces exactly the
# dependency tree that was verified locally. Nested ones are not: web/ is
# pnpm-managed (pnpm-lock.yaml) and its package-lock.json is a stale leftover.
package-lock.json
!/package-lock.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Gradle output from local native modules
/modules/*/android/build
/modules/*/android/.cxx
