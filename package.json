{
  "name": "qamar360",
  "main": "expo-router/entry",
  "version": "1448.3.3",
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.40.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@supabase/supabase-js": "^2.112.3",
    "astronomy-engine": "^2.1.19",
    "expo": "~57.0.13",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.2",
    "expo-build-properties": "~57.0.11",
    "expo-constants": "~57.0.2",
    "expo-dev-client": "~57.0.12",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-executorch": "^0.9.3",
    "react-native-executorch-expo-resource-fetcher": "^0.9.1",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.0",
    "react-native-sherpa-onnx": "^0.4.3",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "colorjs.io": "^0.7.1",
    "culori": "^4.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-import-resolver-typescript": "3.10.1",
    "fontkit": "^2.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "knip": "^6.32.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@react-native/jest-preset": "0.85.3",
    "react-dom": "19.2.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "version:hijri": "node scripts/hijri-version.mjs",
    "gen:palette": "node scripts/gen-palette.mjs",
    "gen:stars": "node scripts/gen-stars.mjs",
    "gen:tz-coords": "node scripts/gen-tz-coords.mjs",
    "gen:moons": "node scripts/gen-moons.mjs",
    "gen:fonts": "python3 scripts/build-fonts.py",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "deps:check": "bash ./scripts/update-deps.sh",
    "deps:update": "bash ./scripts/update-deps.sh --apply",
    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "test": "jest",
    "test:watch": "jest --watch",
    "validate": "npm run typecheck && npm run lint:ci && npm run deadcode && npm run test",
    "verify": "npm run validate",
    "release": "./scripts/release.sh all",
    "release:check": "./scripts/release.sh --check all",
    "release:ios": "./scripts/release.sh ios",
    "release:android": "./scripts/release.sh android",
    "release:all": "./scripts/release.sh all"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true
}
