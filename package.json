    "@supabase/supabase-js": "^2.119.0",
    "astronomy-engine": "^2.1.19",
    "expo": "~58.0.14",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/agent-cli": "^1.0.23",
    "@testing-library/react-native": "^14.1.0",
    "@types/fontkit": "^2.0.9",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "colorjs.io": "^0.7.1",
    "culori": "^4.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "3.10.1",
    "fontkit": "^2.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "knip": "^6.45.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.3.0"
  },
  "scripts": {
    "start": "expo start",
    "version:hijri": "node scripts/hijri-version.mjs",
    "gen:palette": "node scripts/gen-palette.mjs",
    "gen:stars": "node scripts/gen-stars.mjs",
    "gen:tz-coords": "node scripts/gen-tz-coords.mjs",
    "gen:moons": "node scripts/gen-moons.mjs",
    "gen:fonts": "python3 scripts/build-fonts.py",
    "gen:glyphs": "node scripts/gen-material-glyphs.mjs",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "api:check": "node ./scripts/check-deprecated-apis.mjs",
    "deps:check": "bash ./scripts/update-deps.sh",
    "deps:update": "bash ./scripts/update-deps.sh --apply",
    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "test": "jest",
    "test:watch": "jest --watch",
    "validate": "npm run typecheck && npm run lint:ci && npm run deadcode && npm run api:check && npm run test",
    "verify": "npm run validate",
    "release": "./scripts/release.sh all",
    "release:check": "./scripts/release.sh --check all",
    "release:ios": "./scripts/release.sh ios",
    "release:android": "./scripts/release.sh android",
    "release:all": "./scripts/release.sh all"
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true
}
