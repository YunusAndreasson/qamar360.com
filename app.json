{
  "expo": {
    "name": "qamar360",
    "slug": "qamar360",
    "version": "1448.3.20",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qamar360",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.qamar360.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qamar360.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#060910",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/strip-aps-environment.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060910",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#89C2E3"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "useFrameworks": "static"
          }
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.417419719833-o6u0bg7tqjgvovlfib3sc1d303ab0bf9"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75607752-4279-4042-86f4-d37b495d81a8"
      }
    },
    "owner": "edenmind",
    "updates": {
      "url": "https://u.expo.dev/75607752-4279-4042-86f4-d37b495d81a8",
      "fallbackToCacheTimeout": 10000
    }
  }
}
